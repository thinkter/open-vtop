{
  "name": "open-vtop",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "dev-cli": "node src/cli.cjs",
    "build": "tsc && cp src/cli.cjs dist/cli.cjs",
    "start": "node dist/cli.cjs",
    "logs": "node dist/cli.cjs logs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.11.4",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.8",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "bin": {
    "open-vtop": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.11.17",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  },
  "version": "1.0.8"
}
